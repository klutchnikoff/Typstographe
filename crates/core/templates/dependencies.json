{
  "version": 1,
  "capabilities": [
    {
      "id": "dates",
      "entrypoint": "capabilities/dates.typ",
      "signature": "format-date(value: none | datetime | str, lang: \"fr\", format: \"long\" | \"short\" | \"iso\") -> content",
      "packages": ["datify"]
    },
    {
      "id": "correspondence",
      "entrypoint": "capabilities/correspondence.typ",
      "signature": "postscript(body), attachment(body), letter-notes(postscript: body => body, attachments: items => items.join(parbreak()))",
      "packages": []
    },
    {
      "id": "article-layout",
      "entrypoint": "capabilities/article-layout.typ",
      "signature": "layout-body(body), start-page-number(publication)",
      "packages": []
    },
    {
      "id": "authorship",
      "entrypoint": "capabilities/authorship.typ",
      "signature": "prepare-authorship(authors, affiliations), show-authorship(prepared, render-author: auto, render-affiliation: auto)",
      "packages": []
    },
    {
      "id": "abstracts",
      "entrypoint": "capabilities/abstracts.typ",
      "signature": "show-abstracts(localizations, primary-language: \"fr\", render-entry: auto)",
      "packages": []
    },
    {
      "id": "references",
      "entrypoint": "capabilities/references.typ",
      "signature": "citation(body, form: \"normal\"), reference-list(sources, style: \"chicago-author-date\")",
      "packages": []
    },
    {
      "id": "tables",
      "entrypoint": "capabilities/tables.typ",
      "signature": "table-header-cell(body, scope: \"row\") -> content; external Typst CLI requires --features a11y-extras",
      "packages": []
    },
    {
      "id": "figures",
      "entrypoint": "capabilities/figures.typ",
      "signature": "layout-figures(body, column-count: 1, gutter: 12pt) -> content",
      "packages": []
    },
    {
      "id": "cross-references",
      "entrypoint": "capabilities/cross-references.typ",
      "signature": "cross-reference(target: label, include-label: bool, include-page: bool) -> content; reference-style(label: auto, page: auto, combine: auto) -> content",
      "packages": []
    },
    {
      "id": "mathematics",
      "entrypoint": "capabilities/mathematics.typ",
      "signature": "math-formula(source: str, language: \"typst\" | \"latex\", block: bool, alt: str) -> content",
      "packages": ["mitex"]
    }
  ],
  "packages": [
    {
      "name": "datify",
      "version": "1.3.0",
      "root": "packages/datify-1.3.0",
      "entrypoint": "src/main.typ",
      "license": "MIT",
      "archive": "https://packages.typst.org/preview/datify-1.3.0.tar.gz",
      "sha256": "43f313ea6b463469080cfa61e404d51a2d70d7aead6e5365f9b4dc7163519ac6",
      "dependencies": ["datify-core"]
    },
    {
      "name": "datify-core",
      "version": "2.1.0",
      "root": "packages/datify-core-2.1.0",
      "entrypoint": "src/main.typ",
      "license": "MIT AND Unicode-3.0",
      "archive": "https://packages.typst.org/preview/datify-core-2.1.0.tar.gz",
      "sha256": "5a3621f82e88098e8924f811f86b2733e8eeed3a6f08ac8e42507888ef0c29e6",
      "dependencies": []
    },
    {
      "name": "mitex",
      "version": "0.2.7",
      "root": "packages/mitex-0.2.7",
      "entrypoint": "lib.typ",
      "license": "Apache-2.0",
      "archive": "https://packages.typst.org/preview/mitex-0.2.7.tar.gz",
      "sha256": "0159e214845e49cbdc332d9d572da112dae5ad248072e0a7680d38c8307c2e15",
      "dependencies": []
    }
  ]
}
