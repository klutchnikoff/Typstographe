{
  "contract-version": 1,
  "id": "article",
  "label-key": "article-type",
  "description-key": "type-card-article-description",
  "composition": {
    "function": "article"
  },
  "settings-heading-key": "article-settings-heading",
  "export-requirements": [
    {
      "kind": "primary-language",
      "collection": "localizations",
      "language-field": "language",
      "value-field": "title"
    }
  ],
  "fields": [
    {
      "kind": "choice",
      "id": "article.citation_style",
      "label-key": "field-citation-style",
      "required-for-export": false,
      "presentation": "citation-style",
      "statistics": false,
      "choices": ["chicago-author-date", "apa", "ieee"]
    },
    {
      "kind": "boolean",
      "id": "article.show_outline",
      "label-key": "field-show-outline",
      "required-for-export": false,
      "control": "outline",
      "presentation": "outline",
      "statistics": false,
      "default": false
    },
    {
      "kind": "doi",
      "id": "article.publication.doi",
      "label-key": "field-publication-doi",
      "required-for-export": false,
      "statistics": false,
      "default": ""
    },
    {
      "kind": "text",
      "id": "article.publication.venue",
      "label-key": "field-publication-venue",
      "required-for-export": false,
      "statistics": false,
      "multiline": false,
      "default": ""
    },
    {
      "kind": "text",
      "id": "article.publication.kind",
      "label-key": "field-publication-kind",
      "required-for-export": false,
      "statistics": false,
      "multiline": false,
      "default": ""
    },
    {
      "kind": "choice",
      "id": "article.publication.access",
      "label-key": "field-publication-access",
      "required-for-export": false,
      "statistics": false,
      "choices": ["unspecified", "open", "restricted"],
      "choice-labels": [
        "publication-access-unspecified",
        "publication-access-open",
        "publication-access-restricted"
      ],
      "default": "unspecified"
    },
    {
      "kind": "date",
      "id": "article.publication.submitted",
      "label-key": "field-publication-submitted",
      "required-for-export": false,
      "statistics": false,
      "default": null
    },
    {
      "kind": "date",
      "id": "article.publication.accepted",
      "label-key": "field-publication-accepted",
      "required-for-export": false,
      "statistics": false,
      "default": null
    },
    {
      "kind": "date",
      "id": "article.publication.published",
      "label-key": "field-publication-published",
      "required-for-export": false,
      "statistics": false,
      "default": null
    },
    {
      "kind": "text",
      "id": "article.publication.short_citation",
      "label-key": "field-publication-short-citation",
      "required-for-export": false,
      "statistics": false,
      "multiline": false,
      "default": ""
    },
    {
      "kind": "positive-integer",
      "id": "article.publication.first_page",
      "label-key": "field-publication-first-page",
      "required-for-export": false,
      "statistics": false,
      "default": null
    }
  ],
  "collections": [
    {
      "id": "references",
      "kind": "bibliographic-records",
      "identity": "stable-id",
      "max-items": 10000,
      "label-key": "field-bibliography",
      "item-label-key": "field-reference-file",
      "summary-field": "key",
      "summary": [],
      "unique-by": [],
      "fields": []
    },
    {
      "id": "reference_sources",
      "kind": "bibliographic-sources",
      "identity": "stable-id",
      "max-items": 1000,
      "label-key": "field-bibliography",
      "item-label-key": "field-reference-file",
      "summary-field": "name",
      "summary": [],
      "unique-by": [],
      "fields": []
    },
    {
      "id": "authors",
      "kind": "ordered-records",
      "identity": "stable-id",
      "max-items": 100,
      "label-key": "field-article-authors",
      "item-label-key": "article-author",
      "summary-field": "name",
      "summary": ["corresponding"],
      "unique-by": [],
      "fields": [
        {
          "kind": "text",
          "id": "name",
          "label-key": "field-full-name",
          "required-for-export": true,
          "statistics": false,
          "multiline": false,
          "default": ""
        },
        {
          "kind": "record-references",
          "id": "affiliation-ids",
          "label-key": "field-article-affiliations",
          "required-for-export": false,
          "statistics": false,
          "target-collection": "affiliations",
          "unique": true,
          "on-target-remove": "restrict",
          "default": []
        },
        {
          "kind": "text",
          "id": "email",
          "label-key": "field-email",
          "required-for-export": false,
          "statistics": false,
          "multiline": false,
          "default": ""
        },
        {
          "kind": "text",
          "id": "orcid",
          "label-key": "field-orcid",
          "required-for-export": false,
          "statistics": false,
          "multiline": false,
          "default": ""
        },
        {
          "kind": "boolean",
          "id": "corresponding",
          "label-key": "field-corresponding",
          "required-for-export": false,
          "statistics": false,
          "default": false
        }
      ]
    },
    {
      "id": "affiliations",
      "kind": "ordered-records",
      "identity": "stable-id",
      "max-items": 100,
      "label-key": "field-article-affiliations",
      "item-label-key": "article-affiliation",
      "summary-field": "text",
      "summary": [],
      "unique-by": [],
      "fields": [
        {
          "kind": "text",
          "id": "text",
          "label-key": "field-official-affiliation",
          "required-for-export": true,
          "statistics": false,
          "multiline": true,
          "default": ""
        },
        {
          "kind": "text",
          "id": "department",
          "label-key": "field-affiliation-department",
          "required-for-export": false,
          "statistics": false,
          "multiline": false,
          "omit-empty": true,
          "default": ""
        },
        {
          "kind": "text",
          "id": "institution",
          "label-key": "field-affiliation-institution",
          "required-for-export": false,
          "statistics": false,
          "multiline": false,
          "omit-empty": true,
          "default": ""
        },
        {
          "kind": "text",
          "id": "location",
          "label-key": "field-affiliation-location",
          "required-for-export": false,
          "statistics": false,
          "multiline": false,
          "omit-empty": true,
          "default": ""
        }
      ]
    },
    {
      "id": "localizations",
      "kind": "ordered-records",
      "identity": "stable-id",
      "max-items": 7,
      "label-key": "field-article-localizations",
      "item-label-key": "article-localization",
      "summary-field": "language",
      "summary": [],
      "language-key": "language",
      "removal-notice-key": "article-localization-removal-notice",
      "unique-by": ["language"],
      "fields": [
        {
          "kind": "language",
          "id": "language",
          "label-key": "field-language",
          "required-for-export": false,
          "statistics": false,
          "default": "fr"
        },
        {
          "kind": "rich-text",
          "id": "title",
          "label-key": "field-article-title",
          "required-for-export": false,
          "statistics": false,
          "profile": "inline-text",
          "default": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph"
              }
            ]
          }
        },
        {
          "kind": "rich-text",
          "id": "short-title",
          "label-key": "field-short-title",
          "required-for-export": false,
          "statistics": false,
          "profile": "inline-text",
          "default": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph"
              }
            ]
          }
        },
        {
          "kind": "rich-text",
          "id": "subtitle",
          "label-key": "field-subtitle",
          "required-for-export": false,
          "statistics": false,
          "profile": "inline-text",
          "default": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph"
              }
            ]
          }
        },
        {
          "kind": "rich-text",
          "id": "abstract",
          "label-key": "field-abstract",
          "required-for-export": false,
          "statistics": true,
          "profile": "rich-text",
          "default": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph"
              }
            ]
          }
        },
        {
          "kind": "tokens",
          "id": "keywords",
          "label-key": "field-keywords",
          "required-for-export": false,
          "statistics": false,
          "default": []
        }
      ]
    }
  ],
  "capabilities": [
    "block.paragraph",
    "block.heading_1",
    "block.heading_2",
    "block.heading_3",
    "text.bold",
    "text.italic",
    "text.link",
    "block.bullet",
    "block.numbered",
    "block.description",
    "block.quote",
    "insert.image",
    "insert.table",
    "insert.citation",
    "insert.reference",
    "math.inline",
    "math.block",
    "insert.footnote"
  ],
  "bindings": [
    {
      "collection": "authors",
      "typst-parameter": "authors"
    },
    {
      "collection": "affiliations",
      "typst-parameter": "affiliations"
    },
    {
      "collection": "localizations",
      "typst-parameter": "localizations"
    },
    {
      "collection": "references",
      "typst-parameter": "references"
    },
    {
      "collection": "reference_sources",
      "typst-parameter": "reference-sources",
      "metadata-key": "reference_sources"
    },
    {
      "field": "article.citation_style",
      "typst-parameter": "citation-style",
      "metadata-key": "citation_style"
    },
    {
      "field": "article.show_outline",
      "typst-parameter": "show-outline",
      "metadata-key": "show_outline"
    },
    {
      "field": "article.publication.doi",
      "typst-parameter": "doi",
      "typst-group": "publication",
      "metadata-key": "publication_doi"
    },
    {
      "field": "article.publication.venue",
      "typst-parameter": "venue",
      "typst-group": "publication",
      "metadata-key": "publication_venue"
    },
    {
      "field": "article.publication.kind",
      "typst-parameter": "kind",
      "typst-group": "publication",
      "metadata-key": "publication_kind"
    },
    {
      "field": "article.publication.access",
      "typst-parameter": "access",
      "typst-group": "publication",
      "metadata-key": "publication_access"
    },
    {
      "field": "article.publication.submitted",
      "typst-parameter": "submitted",
      "typst-group": "publication",
      "metadata-key": "publication_submitted"
    },
    {
      "field": "article.publication.accepted",
      "typst-parameter": "accepted",
      "typst-group": "publication",
      "metadata-key": "publication_accepted"
    },
    {
      "field": "article.publication.published",
      "typst-parameter": "published",
      "typst-group": "publication",
      "metadata-key": "publication_published"
    },
    {
      "field": "article.publication.short_citation",
      "typst-parameter": "short-citation",
      "typst-group": "publication",
      "metadata-key": "publication_short_citation"
    },
    {
      "field": "article.publication.first_page",
      "typst-parameter": "first-page",
      "typst-group": "publication",
      "metadata-key": "publication_first_page"
    }
  ],
  "header": {
    "tabs": [
      {
        "view": "record-cards",
        "id": "titles",
        "label-key": "group-article-titles",
        "collection": "localizations",
        "summary-field": "title",
        "fields": ["language", "title", "subtitle", "short-title"],
        "editing": "dialog",
        "item-label-key": "field-article-title"
      },
      {
        "view": "record-cards",
        "id": "abstracts",
        "label-key": "group-article-abstracts",
        "collection": "localizations",
        "summary-field": "language",
        "fields": ["language", "abstract", "keywords"],
        "editing": "dialog",
        "item-label-key": "field-abstract"
      },
      {
        "view": "record-cards",
        "id": "affiliations",
        "label-key": "field-article-affiliations",
        "collection": "affiliations",
        "summary-field": "text",
        "fields": [],
        "editing": "dialog"
      },
      {
        "view": "record-cards",
        "id": "authors",
        "label-key": "field-article-authors",
        "collection": "authors",
        "summary-field": "name",
        "fields": [],
        "editing": "dialog"
      },
      {
        "view": "bibliography",
        "id": "bibliography",
        "label-key": "field-bibliography",
        "collection": "references",
        "style-field": "article.citation_style"
      },
      {
        "view": "form",
        "id": "publication",
        "label-key": "group-publication",
        "sections": [
          {
            "id": "publication-identity",
            "label-key": "group-publication-identity",
            "fields": [
              "article.publication.doi",
              "article.publication.venue",
              "article.publication.kind",
              "article.publication.access",
              "article.publication.short_citation",
              "article.publication.first_page"
            ],
            "layout": "compact"
          },
          {
            "id": "publication-dates",
            "label-key": "group-publication-dates",
            "fields": [
              "article.publication.submitted",
              "article.publication.accepted",
              "article.publication.published"
            ],
            "layout": "compact"
          }
        ]
      }
    ]
  }
}
